<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="grid-export-actions">
        <createTable tableName="MILITARY_WAREHOUSE">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_MILITARY_WAREHOUSE"/>
            </column>
            <column name="LOAI" type="VARCHAR(255)"/>
            <column name="TEN" type="VARCHAR(255)"/>
            <column name="TRANG_THAI" type="VARCHAR(255)"/>
            <column name="NHA_SAN_XUAT" type="VARCHAR(255)"/>
            <column name="SO_SERI" type="VARCHAR(255)"/>
            <column name="SO_LUONG" type="INT"/>
            <column name="NGAY_TIEP_NHAN" type="DATE"/>
            <column name="HAN_SU_DUNG_BAO_DUONG" type="DATE"/>
            <column name="CO_NONG" type="VARCHAR(255)"/>
            <column name="GHI_CHU" type="VARCHAR(255)"/>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>