<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://militaryWarehouseListView.title"
      focusComponent="militaryWarehousesDataGrid">

    <data>
        <collection id="militaryWarehousesDc"
                    class="com.gridexportactions.entity.MilitaryWarehouse">
            <fetchPlan extends="_base"/>
            <loader id="militaryWarehousesDl" readOnly="true">
                <query><![CDATA[select e from MilitaryWarehouse e]]></query>
            </loader>
        </collection>
    </data>

    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>

    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>

    <layout>
        <genericFilter id="genericFilter" dataLoader="militaryWarehousesDl">
            <properties include=".*"/>
        </genericFilter>

        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="addButton" action="militaryWarehousesDataGrid.addAction"/>
            <button id="createButton" action="militaryWarehousesDataGrid.createAction"/>
            <button id="editButton" action="militaryWarehousesDataGrid.editAction"/>

            <!-- Gộp cột tạm (UI-only, không lưu DB) -->
            <button id="mergeColumnBtn"
                    action="militaryWarehousesDataGrid.mergeColumn"
                    text="Gộp cột (tạm)"
                    icon="vaadin:columns"/>

            <!-- CHỈ dùng action xuất Excel chung đã tạo -->
            <button id="excelExportSheetingBtn"
                    action="militaryWarehousesDataGrid.excelExportSheeting"
                    text="Xuất Excel"
                    icon="vaadin:file-table"
                    themeNames="primary"/>

            <button id="removeButton" action="militaryWarehousesDataGrid.removeAction"/>
            <simplePagination id="pagination" dataLoader="militaryWarehousesDl"/>
        </hbox>

        <dataGrid id="militaryWarehousesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="militaryWarehousesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="addAction" type="list_add"/>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>

                <!-- Gộp cột tạm thời -->
                <action id="mergeColumn" type="grid_mergeColumn"/>

                <!-- Export Sheeting TÙY CHỈNH (chung) -->
                <action id="excelExportSheeting" type="sheeting_excelExport"/>

                <action id="removeAction" type="list_remove"/>
            </actions>

            <columns resizable="true">
                <column property="loai"/>
                <column property="ten"/>
                <column property="trangThai"/>
                <column property="nhaSanXuat"/>
                <column property="soSeri"/>
                <column property="soLuong"/>
                <column property="ngayTiepNhan"/>
                <column property="hanSuDungBaoDuong"/>
                <column property="coNong"/>
                <column property="ghiChu"/>
            </columns>
        </dataGrid>

        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
