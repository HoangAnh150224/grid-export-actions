<?xml version="1.0" encoding="UTF-8"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="DB Tables">

    <data>
        <!-- Danh sách bảng -->
        <keyValueCollection id="tablesDc">
            <properties>
                <property name="schema" datatype="string"/>
                <property name="name" datatype="string"/>
                <property name="type" datatype="string"/>
                <property name="remarks" datatype="string"/>
            </properties>
        </keyValueCollection>

        <!-- Cột của bảng đang chọn -->
        <keyValueCollection id="fieldsDc">
            <properties>
                <property name="name" datatype="string"/>
                <property name="dataType" datatype="string"/>
                <property name="size" datatype="int"/>
                <property name="nullable" datatype="boolean"/>
                <property name="default" datatype="string"/>
                <property name="remarks" datatype="string"/>
            </properties>
        </keyValueCollection>
    </data>

    <layout width="100%" height="100%" padding="false" spacing="true" expand="colsTwin">

        <!-- Toolbar chọn bảng + cấu hình template -->
        <hbox width="100%" spacing="8px" alignItems="CENTER">
            <hbox spacing="8px" alignItems="CENTER">
                <label text="Chọn bảng" styleName="h4"/>
                <comboBox id="tablesCb" width="420px"/>
                <label id="tableInfo" width="100%"/>
            </hbox>

            <hbox spacing="12px" alignItems="END">
                <!-- Upload template Excel -->
                <fileStorageUploadField id="templateUpload"
                                        label="Template Excel"
                                        width="260px"/>
                <!-- Sheet name -->
                <textField id="sheetNameField" label="Sheet name" width="180px"/>

                <!-- Name Manager anchors -->
                <textField id="headerAnchorField" label="Header Named Range" width="200px"/>
                <textField id="dataAnchorField" label="Data Named Range" width="200px"/>
                <checkbox id="templateHasHeaderCb" label="Template có header" />
            </hbox>
        </hbox>

        <!-- Chọn cột -->
        <twinColumn id="colsTwin"
                    itemsContainer="fieldsDc"
                    itemsColumnLabel="Danh sách cột không được in"
                    selectedItemsColumnLabel="Danh sách cột được in"
                    width="100%" height="100%"
                    selectAllButtonsVisible="true"/>

        <!-- JSON state nội bộ (ẩn) -->
        <label id="jsonPreview" visible="false"/>

        <hbox spacing="8px">
            <button id="saveBtn" text="Lưu" themeNames="success" icon="vaadin:check"/>
            <button id="cancelBtn" text="Hủy" icon="vaadin:close"/>
        </hbox>

    </layout>
</view>
