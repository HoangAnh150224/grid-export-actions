<?xml version="1.0" encoding="UTF-8"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="DB Tables">

    <data>
        <!-- Danh sách bảng -->
        <keyValueCollection id="tablesDc">
            <properties>
                <property name="schema" datatype="string"/>
                <property name="name" datatype="string"/>
                <property name="type" datatype="string"/>
                <property name="remarks" datatype="string"/>
            </properties>
        </keyValueCollection>

        <!-- Cột của bảng đang chọn -->
        <keyValueCollection id="fieldsDc">
            <properties>
                <property name="name" datatype="string"/>
                <property name="dataType" datatype="string"/>
                <property name="size" datatype="int"/>
                <property name="nullable" datatype="boolean"/>
                <property name="default" datatype="string"/>
                <property name="remarks" datatype="string"/>
            </properties>
        </keyValueCollection>

        <!-- Cột được in + metadata + biến template -->
        <keyValueCollection id="selectedDc">
            <properties>
                <property name="name" datatype="string"/>
                <property name="dataType" datatype="string"/>
                <property name="size" datatype="int"/>
                <property name="nullable" datatype="boolean"/>
                <property name="default" datatype="string"/>
                <property name="remarks" datatype="string"/>
                <property name="tplVar" datatype="string"/>
            </properties>
        </keyValueCollection>
    </data>

    <layout width="100%" height="100%" padding="false" spacing="true">

        <!-- Toolbar -->
        <hbox width="100%" spacing="8px" alignItems="CENTER">
            <hbox spacing="8px" alignItems="CENTER">
                <span text="Chọn bảng" classNames="h4"/>
                <comboBox id="tablesCb" width="420px"/>
                <span id="tableInfo" width="100%"/>
            </hbox>

            <hbox spacing="12px" alignItems="END">
                <fileStorageUploadField id="templateUpload" label="Template Excel" width="260px"/>
                <textField id="sheetNameField" label="Sheet name" width="180px"/>
                <checkbox id="templateHasHeaderCb" label="Template có header"/>
            </hbox>
        </hbox>

        <!-- Work area: trái Grid nguồn, giữa nút chuyển, phải Grid chọn + Form -->
        <hbox width="100%" height="100%" spacing="12px">
            <!-- Trái: Grid liệt kê toàn bộ cột của bảng -->
            <vbox width="45%" height="100%" spacing="8px">
                <span classNames="h5" text="Danh sách cột"/>
                <dataGrid id="fieldsGrid"
                          dataContainer="fieldsDc"
                          width="100%" height="100%"
                          selectionMode="SINGLE"
                          themeNames="row-stripes">
                    <columns>
                        <column property="name" header="Tên cột" autoWidth="true"/>
                        <column property="dataType" header="Kiểu" autoWidth="true"/>
                        <column property="size" header="Size" autoWidth="true"/>
                        <column property="nullable" header="Null?" autoWidth="true"/>
                    </columns>
                </dataGrid>
            </vbox>

            <!-- Giữa: nút chuyển -->
            <vbox width="80px" alignItems="CENTER" justifyContent="CENTER" spacing="8px">
                <button id="addBtn"       icon="vaadin:angle-right"         title="Thêm các cột đã chọn"/>
                <button id="addAllBtn"    icon="vaadin:angle-double-right"  title="Thêm tất cả"/>
                <button id="removeBtn"    icon="vaadin:angle-left"          title="Gỡ các cột đã chọn bên phải"/>
                <button id="removeAllBtn" icon="vaadin:angle-double-left"   title="Gỡ tất cả bên phải"/>
            </vbox>


            <!-- Phải: Grid (sửa trực tiếp tplVar) + Form chi tiết -->
            <!-- Phải: chỉ còn Grid, edit trực tiếp tplVar -->
            <vbox id="rightPane" width="45%" height="100%" spacing="10px">
                <span classNames="h5" text="Cột sẽ in"/>
                <dataGrid id="varsGrid"
                          dataContainer="selectedDc"
                          width="100%" height="100%"
                          editorBuffered="false"
                          selectionMode="SINGLE"
                          themeNames="row-stripes">
                    <columns>
                        <column property="name"   header="Cột sẽ in"        autoWidth="true"/>
                        <column property="tplVar" header="Tên biến (Excel)" editable="true" autoWidth="true"/>
                    </columns>
                </dataGrid>
            </vbox>
        </hbox>

        <!-- JSON state (ẩn) -->
        <span id="jsonPreview" visible="true"/>

        <hbox spacing="8px">
            <button id="saveBtn" text="Lưu" themeNames="success" icon="vaadin:check"/>
            <button id="cancelBtn" text="Hủy" icon="vaadin:close"/>
        </hbox>
    </layout>
</view>
